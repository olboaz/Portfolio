<%= form_with(model: tool, local: true) do |f| %>

  <% if tool.errors.any? %>
    <div class="alert alert-danger">
      <% tool.errors.full_messages.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <div class="form-group mb-3">
    <%= f.label :name, "Nom de l'outil" %>
    <%= f.text_field :name, class: "form-control" %>
  </div>

  <div class="form-group mb-3">
    <%= f.label :tool_type, "Catégorie" %>
    <%= f.text_field :tool_type, class: "form-control" %>
  </div>

  <% if tool.persisted? && tool.tool_photo.attached? %>
    <div class="mb-3">
      <p class="text-muted">Logo actuel</p>

      <%= cl_image_tag tool.tool_photo.key,
          width: 100,
          height: 100,
          crop: :fit,
          class: "img-thumbnail",
          alt: tool.name %>
    </div>
  <% end %>

  <div class="form-group mb-4">
    <%= f.label :tool_photo, "Logo" %>
    <%= f.file_field :tool_photo,
        class: "form-control-file",
        accept: "image/jpeg,image/png,image/webp" %>

    <small class="form-text text-muted">
      Formats acceptés : JPEG, PNG, WebP. Taille maximale : 5 Mo.
      <br>
      Laisser vide pour conserver le logo actuel.
    </small>
  </div>

  <%= f.submit tool.persisted? ? "Enregistrer les modifications" : "Créer l'outil",
               class: "btn btn-primary" %>

  <%= link_to "Annuler", tools_path,
              class: "btn btn-outline-secondary" %>
<% end %>