<div class="container project-detail">

  <%# ===== NAVIGATION ===== %>
  <div class="project-detail__topbar">

    <%= link_to "← Retour au portfolio",
        root_path(anchor: "portfolio"),
        class: "project-detail__back" %>

    <% if policy(@project).update? %>
      <%= link_to "Modifier le projet",
          edit_project_path(@project),
          class: "btn btn-outline-secondary btn-sm" %>
    <% end %>

  </div>

  <%# ===== EN-TÊTE ===== %>
  <header class="project-detail__header">

    <h1 class="project-detail__title">
      <%= @project.name %>
    </h1>

    <div class="project-detail__meta">

      <% if @project.project_type.present? %>
        <span class="project-detail__category">
          <%= @project.project_type %>
        </span>
      <% end %>

      <% if @project.valid_external_url? %>
        <%= link_to "Visiter le site ↗",
            @project.url,
            target: "_blank",
            rel: "noopener noreferrer",
            class: "btn btn-primary" %>
      <% end %>

    </div>

  </header>

  <%# ===== IMAGE PRINCIPALE ===== %>
  <% if @project.project_photo.attached? %>
    <% gallery_count = (@project.project_photo.attached? ? 1 : 0) + @project.photos.size %>
    <div class="project-detail__hero">
      <%= cl_image_tag @project.project_photo.key,
          width: 1200,
          crop: :limit,
          class: "img-fluid",
          alt: @project.name,
          tabindex: 0 %>
      <% if gallery_count > 1 %>
        <div class="project-detail__navigation mt-3 d-flex justify-content-center align-items-center">
          <button type="button"
                  class="btn btn-outline-secondary project-detail__prev"
                  aria-label="Image précédente">
            ←
          </button>

          <span class="project-detail__counter mx-3" aria-live="polite">
            1 / <%= gallery_count %>
          </span>

          <button type="button"
                  class="btn btn-outline-secondary project-detail__next"
                  aria-label="Image suivante">
            →
          </button>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# ===== DESCRIPTION ===== %>
  <% if @project.description.present? %>
    <section class="project-detail__description">
      <h2 class="h4 mb-3">À propos du projet</h2>

      <%= simple_format(@project.description) %>
    </section>
  <% end %>

  <%# ===== GALERIE DU PROJET ===== %>
  <% gallery_photos = [] %>

  <% gallery_photos << @project.project_photo if @project.project_photo.attached? %>
  <% gallery_photos.concat(@project.photos.to_a) if @project.photos.attached? %>

  <% if gallery_photos.size > 1 %>
    <div class="project-detail__gallery">

      <h2 class="h4 mb-3">Galerie du projet</h2>

      <div class="project-detail__thumbnails">
        <% gallery_photos.each_with_index do |photo, index| %>
          <button
            type="button"
            class="project-detail__thumbnail <%= 'is-active' if index.zero? %>"
            data-image-url="<%= cl_image_path(photo.key, width: 1200, crop: :limit) %>"
            aria-label="Afficher l'image <%= index + 1 %>"
            aria-pressed="<%= index.zero? %>">

            <%= cl_image_tag photo.key,
                width: 160,
                height: 110,
                crop: :fit,
                alt: "#{@project.name} - Image #{index + 1}" %>

          </button>
        <% end %>
      </div>

    </div>
  <% end %>

  <%# ===== VISIONNEUSE PLEIN ÉCRAN ===== %>
  <% if @project.project_photo.attached? || @project.photos.attached? %>
    <div class="project-lightbox"
        role="dialog"
        aria-modal="true"
        aria-label="Visionneuse des images du projet"
        aria-hidden="true"
        hidden>

      <button type="button"
              class="project-lightbox__close"
              aria-label="Fermer la visionneuse">
        &times;
      </button>

      <img class="project-lightbox__image"
          alt="<%= @project.name %>">

      <div class="project-lightbox__navigation">
        <button type="button"
                class="project-lightbox__prev"
                aria-label="Image précédente">
          &#8592;
        </button>

        <span class="project-lightbox__counter" aria-live="polite"></span>

        <button type="button"
                class="project-lightbox__next"
                aria-label="Image suivante">
          &#8594;
        </button>
      </div>

    </div>
  <% end %>


</div>
