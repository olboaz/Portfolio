
<%= form_with(model: project, local: true) do |f| %>

  <%# ===== ERREURS DE VALIDATION ===== %>
  <% if project.errors.any? %>
    <div class="alert alert-danger">
      <h5>
        <%= pluralize(project.errors.count, "erreur") %>
        lors de l'enregistrement :
      </h5>

      <ul class="mb-0">
        <% project.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# ===== INFORMATIONS DU PROJET ===== %>

  <div class="form-group mb-3">
    <%= f.label :name, "Nom du projet" %>
    <%= f.text_field :name,
        class: "form-control",
        placeholder: "Nom du projet",
        required: true %>
  </div>

  <div class="form-group mb-3">
    <%= f.label :project_type, "Catégorie du projet" %>
    <%= f.text_field :project_type,
        class: "form-control",
        placeholder: "Ex : Web Development, Data Analyse..." %>
  </div>

  <div class="form-group mb-3">
    <%= f.label :description, "Description" %>
    <%= f.text_area :description,
        rows: 5,
        class: "form-control",
        placeholder: "Description du projet..." %>
  </div>

  <div class="form-group mb-3">
    <%= f.label :url, "URL du projet" %>
    <%= f.url_field :url,
        class: "form-control",
        placeholder: "https://..." %>
  </div>

  <%# ===== IMAGE PRINCIPALE ===== %>

  <div class="form-group mb-4">
    <%= f.label :project_photo, "Image principale" %>

    <% if project.persisted? && project.project_photo.attached? %>
      <div class="mb-3">
        <p class="text-muted mb-2">Image actuelle :</p>

        <%= cl_image_tag project.project_photo.key,
            width: 300,
            height: 200,
            crop: :fit,
            class: "img-thumbnail project-main-preview",
            alt: "Image principale du projet" %>
      </div>
    <% end %>

    <%= f.file_field :project_photo,
        class: "form-control-file",
        accept: "image/*" %>

    <small class="form-text text-muted">
      Laisser vide pour conserver l'image actuelle.
    </small>
  </div>

  <%# ===== IMAGES SUPPLÉMENTAIRES ===== %>

  <div class="form-group mb-4">
    <%= f.label :photos, "Images supplémentaires" %>

    <% if project.persisted? && project.photos.attached? %>
      <div class="mb-3">
        <p class="text-muted mb-2">
          Images actuellement associées au projet :
        </p>

        <div class="d-flex flex-wrap">
          <% project.photos.each do |photo| %>
            <div class="mr-2 mb-2">
              <%= cl_image_tag photo.key,
                  width: 120,
                  height: 90,
                  crop: :fill,
                  class: "img-thumbnail project-photo-preview",
                  alt: "Photo du projet" %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <%= f.file_field :photos,
        multiple: true,
        class: "form-control-file",
        accept: "image/*" %>

    <small class="form-text text-muted">
      Sélectionner plusieurs fichiers pour ajouter des images.
      Les images existantes ne doivent pas être supprimées.
    </small>
  </div>

  <%# ===== ACTIONS ===== %>

  <div class="d-flex align-items-center mt-4">
    <%= f.submit(
        project.persisted? ? "Enregistrer les modifications" : "Créer le projet",
        class: "btn btn-primary mr-2"
    ) %>

    <%= link_to "Annuler",
        projects_path,
        class: "btn btn-outline-secondary" %>
  </div>

<% end %>
