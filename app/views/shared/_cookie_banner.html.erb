<div
  id="cookie-consent-banner"
  class="cookie-consent-banner"
  role="region"
  aria-label="Préférences de confidentialité"
  hidden
>
  <div class="cookie-consent-content">
    <p class="mb-2">
      <strong>Respect de votre vie privée</strong>
    </p>

    <p class="mb-3">
      Ce site utilise Google Analytics pour mesurer sa
      fréquentation et améliorer son contenu.
      Vous pouvez accepter ou refuser ces cookies
      sans conséquence sur votre navigation.
    </p>

    <div class="cookie-consent-actions">
      <button
        type="button"
        id="cookie-reject"
        class="btn btn-outline-secondary btn-sm"
      >
        Tout refuser
      </button>

      <button
        type="button"
        id="cookie-accept"
        class="btn btn-primary btn-sm"
      >
        Tout accepter
      </button>
    </div>

    <p class="mt-2 mb-0">
      <a href="<%= privacy_path %>" class="small">
        En savoir plus sur vos données
      </a>
    </p>
  </div>
</div>